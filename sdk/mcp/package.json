{
  "name": "hellovm-mcp",
  "version": "0.0.1",
  "description": "MCP server (stdio) that gives a model a hellovm sandbox",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hellovm-mcp": "dist/server.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "hellovm": "file:../ts",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^7.0.2"
  }
}
